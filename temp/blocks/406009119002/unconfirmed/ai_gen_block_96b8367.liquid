{% doc %}
  @prompt
    glowing product card carousel with the middle elevated, change it so that the first one is elevated, align it to the left
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-carousel-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    padding: 60px 0;
  }

  .ai-product-carousel__wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-end;
    gap: {{ block.settings.card_gap }}px;
    justify-content: flex-start;
    padding: 0 20px;
  }

  .ai-product-carousel__card-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.card_width }}px;
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    text-decoration: none;
    color: {{ block.settings.text_color }};
    position: relative;
    transition: all 0.4s ease;
    box-shadow: 0 0 {{ block.settings.glow_blur }}px {{ block.settings.glow_spread }}px {{ block.settings.glow_color }};
  }

  .ai-product-carousel__card-{{ ai_gen_id }}:first-child {
    transform: translateY(-{{ block.settings.elevation_offset }}px) scale({{ block.settings.elevation_scale }});
    box-shadow: 0 0 {{ block.settings.glow_blur | times: 1.5 }}px {{ block.settings.glow_spread | times: 1.5 }}px {{ block.settings.glow_color }};
  }

  .ai-product-carousel__card-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px);
    box-shadow: 0 0 {{ block.settings.glow_blur | times: 1.3 }}px {{ block.settings.glow_spread | times: 1.3 }}px {{ block.settings.glow_color }};
  }

  .ai-product-carousel__card-{{ ai_gen_id }}:first-child:hover {
    transform: translateY(-{{ block.settings.elevation_offset | plus: block.settings.hover_lift }}px) scale({{ block.settings.elevation_scale }});
  }

  .ai-product-carousel__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    margin-bottom: 15px;
  }

  .ai-product-carousel__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-carousel__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-carousel__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-product-carousel__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: 600;
    margin: 0 0 8px;
    color: {{ block.settings.text_color }};
  }

  .ai-product-carousel__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_font_size }}px;
    font-weight: 500;
    color: {{ block.settings.price_color }};
  }

  .ai-product-carousel__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    color: #666;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-product-carousel__wrapper-{{ ai_gen_id }} {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .ai-product-carousel__wrapper-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ai-product-carousel__card-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.card_width | times: 0.8 }}px;
    }
  }
{% endstyle %}

<product-carousel-{{ ai_gen_id }} class="ai-product-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.products.count > 0 %}
    <div class="ai-product-carousel__wrapper-{{ ai_gen_id }}">
      {% for product in block.settings.products %}
        <a href="{{ product.url }}" class="ai-product-carousel__card-{{ ai_gen_id }}">
          <div class="ai-product-carousel__image-wrapper-{{ ai_gen_id }}">
            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 600 }}"
                alt="{{ product.featured_image.alt | escape }}"
                class="ai-product-carousel__image-{{ ai_gen_id }}"
                loading="lazy"
                width="600"
                height="600"
              >
            {% else %}
              <div class="ai-product-carousel__image-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          <h3 class="ai-product-carousel__title-{{ ai_gen_id }}">{{ product.title }}</h3>
          <div class="ai-product-carousel__price-{{ ai_gen_id }}">{{ product.price | money }}</div>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <div class="ai-product-carousel__empty-state-{{ ai_gen_id }}">
      Next, select products to display in the carousel
    </div>
  {% endif %}
</product-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.wrapper = this.querySelector('.ai-product-carousel__wrapper-{{ ai_gen_id }}');
        if (this.wrapper) {
          this.enableTouchScroll();
        }
      }

      enableTouchScroll() {
        let isDown = false;
        let startX;
        let scrollLeft;

        this.wrapper.addEventListener('mousedown', (e) => {
          isDown = true;
          startX = e.pageX - this.wrapper.offsetLeft;
          scrollLeft = this.wrapper.scrollLeft;
        });

        this.wrapper.addEventListener('mouseleave', () => {
          isDown = false;
        });

        this.wrapper.addEventListener('mouseup', () => {
          isDown = false;
        });

        this.wrapper.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const x = e.pageX - this.wrapper.offsetLeft;
          const walk = (x - startX) * 2;
          this.wrapper.scrollLeft = scrollLeft - walk;
        });
      }
    }

    customElements.define('product-carousel-{{ ai_gen_id }}', ProductCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Glowing product carousel",
  "settings": [
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "limit": 8
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card width",
      "min": 200,
      "max": 400,
      "step": 20,
      "unit": "px",
      "default": 280
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap between cards",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 10,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Elevation"
    },
    {
      "type": "range",
      "id": "elevation_offset",
      "label": "First card elevation",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "elevation_scale",
      "label": "First card scale",
      "min": 1,
      "max": 1.5,
      "step": 0.1,
      "default": 1.1
    },
    {
      "type": "range",
      "id": "hover_lift",
      "label": "Hover lift",
      "min": 0,
      "max": 30,
      "step": 5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Glow effect"
    },
    {
      "type": "color",
      "id": "glow_color",
      "label": "Glow color",
      "default": "#7C9A7E"
    },
    {
      "type": "range",
      "id": "glow_blur",
      "label": "Glow blur",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "glow_spread",
      "label": "Glow spread",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Title size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "price_font_size",
      "label": "Price size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#2C1810"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price color",
      "default": "#7C9A7E"
    }
  ],
  "presets": [
    {
      "name": "Glowing product carousel"
    }
  ]
}
{% endschema %}
